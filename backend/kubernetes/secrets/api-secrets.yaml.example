# ============================================================
# EXAMPLE ONLY — DO NOT COMMIT WITH REAL VALUES
# In production, use:
#   - kubectl create secret generic api-secrets --from-env-file=.env
#   - OR External Secrets Operator + AWS SSM / HashiCorp Vault
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: api-secrets
  namespace: ai-learning
  labels:
    app: ai-learning-api
type: Opaque
stringData:
  # Database — use a connection pooler (pgBouncer) URL in production
  DATABASE_URL: "postgresql+asyncpg://app_user:CHANGE_ME@postgres-pgbouncer:5432/ai_learning"

  # Redis (include password)
  REDIS_URL: "redis://:CHANGE_ME@redis-master:6379/0"

  # Kafka
  KAFKA_BOOTSTRAP_SERVERS: "kafka-headless:9092"

  # Elasticsearch
  ELASTICSEARCH_URL: "http://elasticsearch:9200"
  ELASTICSEARCH_PASSWORD: "CHANGE_ME"

  # Qdrant
  QDRANT_URL: "http://qdrant:6333"
  QDRANT_API_KEY: "CHANGE_ME"

  # Application secrets — generate with: openssl rand -hex 32
  APP_SECRET_KEY: "CHANGE_ME_32_CHARS_MIN"
  JWT_SECRET_KEY: "CHANGE_ME_32_CHARS_MIN"

  # AI APIs
  OPENAI_API_KEY: "sk-CHANGE_ME"
  ANTHROPIC_API_KEY: "sk-ant-CHANGE_ME"

  # Payments
  STRIPE_SECRET_KEY: "sk_live_CHANGE_ME"
  STRIPE_WEBHOOK_SECRET: "whsec_CHANGE_ME"

  # Email
  SENDGRID_API_KEY: "SG.CHANGE_ME"
  FROM_EMAIL: "noreply@ailearning.example.com"

  # Storage
  AWS_ACCESS_KEY_ID: "CHANGE_ME"
  AWS_SECRET_ACCESS_KEY: "CHANGE_ME"
  AWS_REGION: "us-east-1"
  S3_BUCKET_NAME: "ai-learning-assets"

  # OAuth providers
  GOOGLE_CLIENT_ID: "CHANGE_ME"
  GOOGLE_CLIENT_SECRET: "CHANGE_ME"
  GITHUB_CLIENT_ID: "CHANGE_ME"
  GITHUB_CLIENT_SECRET: "CHANGE_ME"
  DISCORD_CLIENT_ID: "CHANGE_ME"
  DISCORD_CLIENT_SECRET: "CHANGE_ME"
