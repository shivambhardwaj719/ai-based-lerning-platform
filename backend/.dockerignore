# Don't copy into Docker image:

# VCS
.git/
.gitignore

# Python caches
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Tests (not needed at runtime)
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
junit.xml

# Type checking caches
.mypy_cache/
.ruff_cache/

# IDE files
.idea/
.vscode/
*.swp
*~
.DS_Store

# Docs
*.md
docs/
ARCHITECTURE.md

# Logs
logs/
*.log

# Kubernetes / deployment configs (not needed in image)
kubernetes/
monitoring/
.github/

# Local dev overrides
docker-compose*.yml
docker-compose*.yaml

# Large data / uploads
minio_data/
uploads/
